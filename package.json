{
  "name": "hotpesa-pay",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && eslint playwright.config.ts e2e",
    "test": "pnpm run verify:discovery && pnpm -r test",
    "test:e2e": "pnpm run verify:e2e-discovery && playwright test",
    "typecheck": "pnpm -r typecheck",
    "verify:e2e-discovery": "node scripts/verify-e2e-discovery.mjs",
    "verify:discovery": "node scripts/verify-discovery.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "local:journey-url": "node scripts/print-local-journey-url.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
