# Local development values only. Never put live credentials in this file.
# Copy to .env.development to override these values for a different local network.
NODE_ENV=development
HOTPESA_STORE=postgres
DATABASE_URL=postgresql://hotpesa:hotpesa_dev_only@127.0.0.1:15432/hotpesa_dev
REDIS_URL=redis://127.0.0.1:6379
HOST=0.0.0.0
PORT=3000
# Change this observed hotspot address in ignored .env.development when Windows assigns a different one.
HOTPESA_LOCAL_HOST=192.168.137.1
CORS_ORIGINS=http://192.168.137.1:4173
VITE_HOST=0.0.0.0
VITE_API_URL=http://192.168.137.1:3000
